        "language": "javaScript",
        "jsCode": "// 실시간 긴급 게이트 — 발신자 화이트리스트 AND 긴급 키워드 (교집합, 좁게 유지)\n// 아래 두 배열만 본인 상황에 맞게 수정하세요.\nconst WHITELIST = ['@school.ac.kr', 'boss@company.com'];  // 발신자 주소 또는 도메인\nconst URGENT = ['긴급', '마감', '즉시', 'urgent', 'asap', 'deadline'];\n\nreturn items.filter((it) => {\n  const j = it.json;\n  const from = (((j.from && j.from.value && j.from.value[0] && j.from.value[0].address) || j.from || '') + '').toLowerCase();\n  const subj = ((j.subject || '') + '').toLowerCase();\n  const senderOK = WHITELIST.some((w) => from.includes(w.toLowerCase()));\n  const urgentOK = URGENT.some((k) => subj.includes(k.toLowerCase()));\n  return senderOK && urgentOK;  // 둘 다 만족해야 통과\n});"
      },
